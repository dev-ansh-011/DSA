class Solution:
    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:
        length = 0
        current = head
        while current:
            length += 1
            current = current.next
        if n == length:
            return head.next
        position = length - n
        current = head
        for _ in range(position - 1):
            current = current.next
        current.next = current.next.next
        
        return head
