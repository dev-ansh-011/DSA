class Solution:
    def copyRandomList(self, head):
        if head is None:
            return None
        mapping = {}
        curr = head
        while curr:
            mapping[curr] = Node(curr.val)
            curr = curr.next
        curr = head
        while curr:
            copy = mapping[curr]
            copy.next = mapping.get(curr.next)
            copy.random = mapping.get(curr.random)
            curr = curr.next

        return mapping[head]
