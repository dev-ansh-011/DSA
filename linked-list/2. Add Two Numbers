class Solution:
    def addTwoNumbers(self, l1, l2):
        result = ListNode(0)
        current = result
        carry = 0
        while l1 or l2 or carry:
            a = 0
            b = 0
            if l1:
                a = l1.val
            if l2:
                b = l2.val
            total = a + b + carry
            carry = total // 10
            digit = total % 10
            current.next = ListNode(digit)
            current = current.next
            if l1:
                l1 = l1.next
            if l2:
                l2 = l2.next

        return result.next
