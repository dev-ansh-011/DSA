class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:

        if len(nums) == 0:
            return 0
        nums.sort()
        count = 1
        temp = 1
        for num in range(0, len(nums) - 1):
            if nums[num] == nums[num + 1]:
                continue
            if nums[num] + 1 == nums[num + 1]:
                temp = temp + 1
            else:
                if temp > count:
                    count = temp
                temp = 1
        if temp > count:
            count = temp

        return count
