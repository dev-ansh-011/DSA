class Solution:
    def isValidSudoku(self, board: List[List[str]]) -> bool:

        for i in range(9):
            seen = []
            for j in range(9):
                num = board[i][j]
                if num != ".":
                    if num in seen:
                        return False
                    seen.append(num)

        for j in range(9):
            seen = []
            for i in range(9):
                num = board[i][j]
                if num != ".":
                    if num in seen:
                        return False
                    seen.append(num)

        for row in range(0, 9, 3):
            for col in range(0, 9, 3):
                seen = []
                for i in range(row, row + 3):
                    for j in range(col, col + 3):
                        num = board[i][j]
                        if num != ".":
                            if num in seen:
                                return False
                            seen.append(num)

        return True
