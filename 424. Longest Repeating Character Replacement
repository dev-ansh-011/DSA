class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        count = {}
        left = 0
        answer = 0
        max_count = 0
        for right in range(len(s)):
            if s[right] in count:
                count[s[right]] += 1
            else:
                count[s[right]] = 1
            if count[s[right]] > max_count:
                max_count = count[s[right]]
            window_length = right - left + 1
            changes = window_length - max_count
            if changes > k:
                count[s[left]] -= 1
                left += 1
            window_length = right - left + 1
            if window_length > answer:
                answer = window_length

        return answer
