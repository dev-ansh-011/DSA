from collections import deque
class Solution:
    def rightSideView(self, root):
        if not root:
            return []
        queue = deque([root])
        answer = []
        while queue:
            level_size = len(queue)
            for i in range(level_size):
                node = queue.popleft()
                if node.left:
                    queue.append(node.left)
                if node.right:
                    queue.append(node.right)
                if i == level_size - 1:
                    answer.append(node.val)

        return answer 
